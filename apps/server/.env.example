# VPS/Bun entrypoint config. Copy to .env and fill in for local dev.

# Comma-separated list of origins allowed to call this API.
CORS_ORIGIN=http://localhost:4400

# Better-Auth. Generate a real secret for anything beyond local dev, e.g.:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4401

# Where the local SQLite database file lives.
DATABASE_PATH=./data/jobgiga.db

# Where uploaded files (resumes, …) are stored locally.
STORAGE_PATH=./storage

PORT=4401

# AI providers (onboarding's company lookup and resume parsing). Leave
# blank for local dev — missing keys fall back to dev-mode stub responses
# (see packages/api/src/lib/ai/).
DEEPSEEK_API_KEY=
MIMO_API_KEY=
PERPLEXITY_API_KEY=
# Optional: company logos for the employer AI lookup (https://logo.dev). Without it, the site favicon is used.
LOGO_DEV_API_KEY=

# Twilio Verify (onboarding's phone verification). Leave blank for local dev
# — a missing config falls back to a dev-mode stub (fixed code "123456",
# see packages/api/src/lib/phone/verify.ts).
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_VERIFY_SERVICE_SID=
