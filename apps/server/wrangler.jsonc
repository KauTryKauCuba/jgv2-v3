{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "jobgiga-v3-server",
	"main": "src/worker.ts",
	"compatibility_date": "2026-01-26",
	"compatibility_flags": ["nodejs_compat"],
	"vars": {
		"CORS_ORIGIN": "http://localhost:4400,https://jgv2.v3.jejaku.my",
		// Dev-only placeholder. Replace with `wrangler secret put BETTER_AUTH_SECRET`
		// before deploying anywhere real.
		"BETTER_AUTH_SECRET": "dev-only-insecure-secret",
		"BETTER_AUTH_URL": "http://localhost:4401",
		// Left blank for local dev — missing keys fall back to dev-mode stub
		// responses (see packages/api/src/lib/ai/). Use
		// `wrangler secret put <NAME>` once real keys exist.
		"MIMO_API_KEY": "",
		"PERPLEXITY_API_KEY": "",
		"LOGO_DEV_API_KEY": "",
		"TWILIO_API_KEY_SID": "",
		"TWILIO_API_KEY_SECRET": "",
		"TWILIO_VERIFY_SERVICE_SID": ""
	},
	// Local dev uses a local D1 database. Replace database_id with the real
	// Cloudflare D1 id before deploying.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "jobgiga-v3",
			"database_id": "local-jobgiga-v3",
			// Same folder the Bun/SQLite path migrates from (packages/db) — one
			// migrations folder for both, per the backend portability plan.
			"migrations_dir": "../../packages/db/src/migrations"
		}
	],
	// Swapped in for the Bun path's local folder (packages/api/src/lib/storage/)
	// with no change to any caller — same Storage interface either way.
	// `wrangler dev` simulates this locally too, same as D1 above.
	"r2_buckets": [
		{
			"binding": "STORAGE",
			"bucket_name": "jobgiga-v3-storage"
		}
	]
}
