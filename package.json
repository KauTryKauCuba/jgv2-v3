{
  "name": "jobgiga-v3",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@orpc/client": "^1.10.0",
      "@orpc/server": "^1.10.0",
      "better-auth": "^1.4.0",
      "drizzle-orm": "^0.44.2",
      "hono": "^4.8.2",
      "zod": "^4.1.11"
    }
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "db:generate": "turbo -F @jobgiga-app/db db:generate",
    "db:migrate": "turbo -F @jobgiga-app/db db:migrate",
    "db:push": "turbo -F @jobgiga-app/db db:push",
    "db:studio": "turbo -F @jobgiga-app/db db:studio"
  },
  "devDependencies": {
    "turbo": "^2.5.4"
  },
  "packageManager": "bun@1.2.18"
}
